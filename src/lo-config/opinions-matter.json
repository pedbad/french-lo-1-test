						[
							"audio/lo7/dialogues/vous-aimez-le-rugby-guillaume.mp3",
							"Vous aimez le rugby, Guillaume?",
							"Do you like rugby, Guillaume?"
						],
						[
							"audio/lo7/dialogues/le-rugby-ah-non-je-deteste-le-rugby-et-vous-qu-est-ce-que-vous-aimez-comme-sports.mp3",
							"Le rugby? Ah non! Je déteste le rugby! Et vous, qu'est-ce que vous aimez comme sports?",
							"Rugby? Oh no! I hate rugby! What about you, what sports do you like?"
						],
						[
							"audio/lo7/dialogues/je-suis-tres-sportif-j-aime-beaucoup-le-rugby-et-le-foot-j-aime-aussi-le-squash-et-le-badminton.mp3",
							"Je suis très sportif! J'aime beaucoup le rugby et le foot. J'aime aussi le squash et le badminton.",
							"I like rugby and football very much. I also like squash and badminton."
						]
					],
					"titleText": "Talking about favourite sports"
