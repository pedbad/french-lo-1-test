{
  "name": "lcexercise",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "build:server": "VITE_BASE_PATH=/projects/french-basic/ vite build",
    "build:live": "VITE_BASE_PATH=/french/french-basic/ vite build",
    "build:with-debug": "VITE_INCLUDE_DEBUG=true vite build",
    "build:server:with-debug": "VITE_BASE_PATH=/projects/french-basic/ VITE_INCLUDE_DEBUG=true vite build",
    "build:live:with-debug": "VITE_BASE_PATH=/french/french-basic/ VITE_INCLUDE_DEBUG=true vite build",
    "lint": "eslint .",
    "lint:changed": "bash scripts/lint-changed.sh --against origin/main",
    "lint:changed:staged": "bash scripts/lint-changed.sh --staged",
    "preview": "vite preview",
    "check:typography": "bash scripts/check-typography-guard.sh --staged",
    "check:typography:branch": "bash scripts/check-typography-guard.sh --against origin/main",
    "check:color": "bash scripts/check-color-guard.sh --staged",
    "check:color:branch": "bash scripts/check-color-guard.sh --against origin/main",
    "check:a11y": "bash scripts/check-a11y-guard.sh --staged",
    "check:a11y:branch": "bash scripts/check-a11y-guard.sh --against origin/main",
    "check:scss": "bash scripts/check-scss-guard.sh --staged",
    "check:scss:branch": "bash scripts/check-scss-guard.sh --against origin/main",
    "check:image-path": "bash scripts/check-image-path-guard.sh --staged",
    "check:image-path:branch": "bash scripts/check-image-path-guard.sh --against origin/main",
    "check:audio-unicode": "node scripts/audio-unicode-guard.mjs --staged --check",
    "check:audio-unicode:branch": "node scripts/audio-unicode-guard.mjs --against origin/main --check",
    "fix:audio-unicode": "node scripts/audio-unicode-guard.mjs --fix",
    "check:config-keys": "bash scripts/check-config-keys-guard.sh --staged",
    "check:config-keys:branch": "bash scripts/check-config-keys-guard.sh --against origin/main",
    "prepush:local": "bun run test:run && bun run lint && bun run check:typography:branch && bun run check:color:branch && bun run check:a11y:branch && bun run check:scss:branch && bun run check:image-path:branch && bun run check:audio-unicode:branch && bun run check:config-keys:branch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.8",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.0",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.15",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^3.5.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "@vitest/coverage-v8": "^2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "sass-embedded": "^1.85.1",
    "tailwindcss": "^4.1.13",
    "vite": "^6.2.3",
    "vite-plugin-static-copy": "^2.3.0",
    "vitest": "^2"
  }
}
